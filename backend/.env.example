# Copy to backend/.env and adjust. Never commit the real file.
ERP_DATABASE_URL=postgresql+psycopg://erp:CHANGE_ME@localhost:5432/tally_erp

# Sync worker
ERP_SYNC_POLL_SECONDS=15
ERP_SYNC_INBOUND_OVERLAP=50
ERP_SYNC_MAX_ATTEMPTS=8
ERP_SYNC_BACKOFF_BASE=5
ERP_SYNC_BACKOFF_CAP=900

# Seconds to wait for Tally. Large companies need more for voucher exports.
ERP_TALLY_TIMEOUT=60

# Set false to reject vouchers that would take stock below zero
ERP_ALLOW_NEGATIVE_STOCK=true
